{
  "name": "prism-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "keys": "node --import tsx scripts/keys.ts",
    "verify:cli": "node --import tsx scripts/verify-cli-live.ts",
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "verify:sample": "node --import tsx scripts/verify-sample.ts",
    "verify:compiler": "node --import tsx scripts/verify-compiler.ts",
    "verify:word-count": "node --import tsx scripts/verify-word-count.ts",
    "verify:source-tools": "node --import tsx scripts/verify-source-tools.ts",
    "verify:tables": "node --import tsx scripts/verify-table-editor.ts",
    "verify:visual-editor": "node --import tsx scripts/verify-visual-editor.ts",
    "verify:project-search": "node --import tsx scripts/verify-project-search.ts",
    "verify:project-copy": "node --import tsx scripts/verify-project-copy.ts",
    "verify:file-moves": "node --import tsx scripts/verify-file-moves.ts",
    "verify:reference-moves": "node --import tsx scripts/verify-reference-moves.ts",
    "verify:pdf-links": "node --import tsx scripts/verify-pdf-links.ts",
    "verify:file-batches": "node --import tsx scripts/verify-file-batches.ts",
    "verify:clipboard": "node --import tsx scripts/verify-clipboard.ts",
    "verify:comments": "node --import tsx scripts/verify-comments.ts",
    "verify:tracking": "node --import tsx scripts/verify-tracking.ts",
    "verify:review-history": "node --import tsx scripts/verify-review-history.ts",
    "verify:history-labels": "node --import tsx scripts/verify-history-labels.ts",
    "verify:templates": "node --import tsx scripts/verify-templates.ts",
    "verify:library": "node --import tsx scripts/verify-library.ts",
    "verify:build-tools": "node --import tsx scripts/verify-build-tools.ts",
    "verify:tex-runtimes": "node --import tsx scripts/verify-tex-runtimes.ts",
    "verify:preview-builds": "node --import tsx scripts/verify-preview-builds.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.8",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "diff": "^8.0.2",
    "fastify": "^5.3.2",
    "fflate": "^0.8.2",
    "htmlparser2": "^10.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  }
}
