# Alternatively enter a key in Settings for this server session only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
# GOOGLE_API_KEY and DASHSCOPE_API_KEY are also recognized.
# Optional: copy the endpoint for your API key's region from Alibaba Cloud.
# QWEN_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# Optional absolute paths if Codex CLI / Claude Code are not on PATH:
# PRISM_CODEX_BIN=/absolute/path/to/codex
# PRISM_CLAUDE_BIN=/absolute/path/to/claude
# Additional installed TeX Live bin/<architecture> directories, colon-separated on macOS.
# Runtime discovery never reads project configuration or installs a distribution.
# PRISM_TEX_BIN_DIRS=/absolute/path/to/texlive/2025/bin/universal-darwin
